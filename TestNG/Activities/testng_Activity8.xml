<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="FSTTests" thread-count="4" parallel="classes">

    <!-- Comment out groups to run everything -->
    <!--
    <groups>
        <run>
            <include name="HeaderTests"/>
        </run>
    </groups>
    -->

    <parameter name="username" value="admin"/>
    <parameter name="password" value="password"/>

    <test name="FSTActivities">
        <classes>
            <class name="testngActivities.Activity1"/>
            <class name="testngActivities.Activity2"/>
            <class name="testngActivities.Activity3"/>
            <class name="testngActivities.Activity4_DemoOne"/>
            <class name="testngActivities.Activity4_DemoTwo"/>
            <class name="testngActivities.Activity5"/>
            <class name="testngActivities.Activity6"/>
            <class name="testngActivities.Activity7"/>
        </classes>
    </test>

</suite>
